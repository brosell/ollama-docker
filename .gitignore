# --- SSH bastion: ignore secrets + runtime state ---
bastion/config/ssh_host_keys/
bastion/config/.ssh/
# generated by the image; runtime state, not source
bastion/config/sshd/sshd_config
# The sshd_config.d/ snippet (bastion.conf) is tracked - it IS the source of truth.
bastion/config/logs/
bastion/config/sshd.pid
bastion/config/.bash_history
bastion/config/authorized_keys
